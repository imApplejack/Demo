{
    "name": "eric/demo",
    "description": "test technique",
    "type": "project",
    "require": {
        "php" : ">=8.2",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Eric\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "friendsofphp/php-cs-fixer": "dev-master"
    },
    "scripts": {
        "tests" : "@php ./vendor/bin/phpunit tests",
        "cs-fixer" : "@php ./vendor/bin/php-cs-fixer fix"
    }
}
